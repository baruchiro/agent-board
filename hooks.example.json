              "CF_ACCESS_CLIENT_SECRET"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "https://agents.example.com/ingest",
            "headers": {
              "Authorization": "Bearer $AGENT_BOARD_TOKEN",
              "CF-Access-Client-Id": "$CF_ACCESS_CLIENT_ID",
              "CF-Access-Client-Secret": "$CF_ACCESS_CLIENT_SECRET"
            },
            "allowedEnvVars": [
              "AGENT_BOARD_TOKEN",
              "CF_ACCESS_CLIENT_ID",
